# Caddy reverse proxy for docker-compose.yml. UI_DOMAIN comes from .env (for example reviews.example.com);
# Caddy obtains and renews the HTTPS certificate for it automatically, as long as the domain's DNS
# points at this server and ports 80 and 443 are open.
{$UI_DOMAIN} {
	encode gzip
	reverse_proxy pr-review-ui:4500
}
