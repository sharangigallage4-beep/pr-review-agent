# --- Required ---

# GitHub token with `pull-requests: write` and `contents: read` permissions. Works against
# private repositories too, as long as the token itself has access to them - there is no
# separate "private repo" mode, authenticated Octokit requests just work.
# In GitHub Actions, the default GITHUB_TOKEN works as long as the workflow's `permissions:`
# block grants both scopes. Never commit a real token to this file.
GITHUB_TOKEN=

# Default repository owner/repo that tool calls fall back to when a call doesn't explicitly
# pass its own owner/repo (e.g. in GitHub Actions, set these to `${{ github.repository_owner }}`
# and the repo name - the workflow only ever needs to review PRs in the repo it runs in).
GITHUB_OWNER=
GITHUB_REPO=

# Anthropic API key for the Claude review engine (src/review/*). Validated separately from the
# GITHUB_* vars above - the review engine has no dependency on the GitHub config or integration.
ANTHROPIC_API_KEY=

# Shared secret configured on the GitHub webhook itself (repo/org Settings -> Webhooks -> your
# webhook -> Secret). Required only by `npm run webhook` (src/webhook/*) - every incoming request
# is HMAC-verified against this before anything else happens. Never commit a real value here.
GITHUB_WEBHOOK_SECRET=

# --- Optional ---

# Port the webhook server (src/webhook/server.ts) listens on. Defaults to 4300.
PORT=

# Overrides the Claude model used for reviews (defaults to a current Claude model in
# src/review/config.ts).
ANTHROPIC_MODEL=

# The bot's own GitHub login (e.g. "github-actions[bot]", or your GitHub App's
# "<app-slug>[bot]" login, or a PAT's own username). Used by get_existing_review_comments to
# filter down to only this bot's own prior comments, which is what de-duplication depends on.
# If left unset, the server tries GET /user to discover it automatically, which works for a
# personal access token but NOT for the Actions-provided GITHUB_TOKEN (that token cannot call
# GET /user) - in that case, set this explicitly or pass `author` on each call.
PR_REVIEW_BOT_LOGIN=

# --- Review web UI (`npm run ui`, src/ui/*) - all optional ---
# Port and bind address. It listens on 127.0.0.1 (this computer only) by default, because the page can
# post comments to GitHub with GITHUB_TOKEN and has no login of its own.
PR_REVIEW_UI_PORT=4500
# If the UI will not start ("Windows does not allow listening"), Windows has reserved that port range:
# run  netsh int ipv4 show excludedportrange protocol=tcp  and pick a port outside every range (e.g. 4700).
PR_REVIEW_UI_HOST=127.0.0.1
# Only if you deliberately share it on a network: extra Host names to accept, comma separated
# (e.g. reviews.corp:4500). Put it behind your own authentication first, e.g. a reverse proxy.
PR_REVIEW_UI_ALLOWED_HOSTS=
# Required (the server refuses to start without it) if PR_REVIEW_UI_HOST is anything but this
# computer: a shared password for the login page. Also set PR_REVIEW_UI_COOKIE_SECURE=true when the
# page is served over HTTPS.
PR_REVIEW_UI_PASSWORD=
PR_REVIEW_UI_COOKIE_SECURE=false
# Where the review history and auto-review state are stored (default: the project folder).
PR_REVIEW_DATA_DIR=
# Folder of rule documents the reviewer reads (default: docs/conventions).
PR_REVIEW_CONVENTIONS_DIR=
# Folder whose sub-folders and .zip files can be reviewed from the page (default: local-input). It is git-ignored.
PR_REVIEW_LOCAL_INPUT_DIR=

# --- Hosting for a team (see DEPLOYMENT.md) ---
# Public address the UI is served at (also used by Caddy for the HTTPS certificate in docker-compose.yml).
UI_DOMAIN=
# Number of reverse proxies in front of the UI (1 for the bundled Caddy). Leave empty when there is none.
PR_REVIEW_UI_TRUST_PROXY=
# A separate website (e.g. a Netlify site) that forwards its /api calls to this server - see DEPLOYMENT.md.
# Comma-separated origins, e.g. https://my-site.netlify.app (no trailing slash).
PR_REVIEW_UI_ALLOWED_ORIGINS=


# --- UI dropdown: Ollama (local) or Claude (API) ---
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# Optional: where Ollama runs and which model (defaults: http://localhost:11434 / qwen2.5-coder:7b)
OLLAMA_BASE_URL=
OLLAMA_MODEL=
# Which one the page starts with: ollama or claude
AI_PROVIDER=

# --- Claude usage and a monthly cap (the UI shows tokens used this month) ---
# Prices (US dollars per million tokens) are NOT built in; copy them from the Anthropic pricing page for
# your model to also see an estimated cost. Leave blank to see tokens only.
CLAUDE_PRICE_INPUT_PER_MTOK=
CLAUDE_PRICE_OUTPUT_PER_MTOK=
# Once reached, new Claude reviews are refused until next month (Ollama is not affected). Blank = no cap.
CLAUDE_MONTHLY_TOKEN_LIMIT=
# A dollar cap only works when both prices above are set.
CLAUDE_MONTHLY_BUDGET_USD=
