# --- Required ---

# GitHub token with `pull-requests: write` and `contents: read` permissions. Works against
# private repositories too, as long as the token itself has access to them - there is no
# separate "private repo" mode, authenticated Octokit requests just work.
# In GitHub Actions, the default GITHUB_TOKEN works as long as the workflow's `permissions:`
# block grants both scopes. Never commit a real token to this file.
GITHUB_TOKEN=

# Default repository owner/repo that tool calls fall back to when a call doesn't explicitly
# pass its own owner/repo (e.g. in GitHub Actions, set these to `${{ github.repository_owner }}`
# and the repo name - the workflow only ever needs to review PRs in the repo it runs in).
GITHUB_OWNER=
GITHUB_REPO=

# Anthropic API key for the Claude review engine (src/review/*). Validated separately from the
# GITHUB_* vars above - the review engine has no dependency on the GitHub config or integration.
ANTHROPIC_API_KEY=

# Shared secret configured on the GitHub webhook itself (repo/org Settings -> Webhooks -> your
# webhook -> Secret). Required only by `npm run webhook` (src/webhook/*) - every incoming request
# is HMAC-verified against this before anything else happens. Never commit a real value here.
GITHUB_WEBHOOK_SECRET=

# --- Optional ---

# Port the webhook server (src/webhook/server.ts) listens on. Defaults to 4300.
PORT=

# Overrides the Claude model used for reviews (defaults to a current Claude model in
# src/review/config.ts).
ANTHROPIC_MODEL=

# The bot's own GitHub login (e.g. "github-actions[bot]", or your GitHub App's
# "<app-slug>[bot]" login, or a PAT's own username). Used by get_existing_review_comments to
# filter down to only this bot's own prior comments, which is what de-duplication depends on.
# If left unset, the server tries GET /user to discover it automatically, which works for a
# personal access token but NOT for the Actions-provided GITHUB_TOKEN (that token cannot call
# GET /user) - in that case, set this explicitly or pass `author` on each call.
PR_REVIEW_BOT_LOGIN=
